#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    macros {
        clear_pairing: clear_pairing {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&bt BT_CLR>;
        };
    };

    behaviors {
        pairing_hold: pairing_hold {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <5000>;
            bindings = <&clear_pairing>, <&none>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_pairing_reset {
            // Tee Box Left + Tee Box Right.
            key-positions = <0 4>;
            timeout-ms = <100>;
            bindings = <&pairing_hold 0 0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp C  &kp LEFT  &kp DOWN  &kp RIGHT  &kp V
                &kp K  &kp I     &kp UP    &kp P      &kp LC(M)
                &kp U  &kp F3    &kp W     &kp B      &kp O
                &kp A  &kp T     &kp Q     &kp S      &kp Y
            >;
        };
    };
};
